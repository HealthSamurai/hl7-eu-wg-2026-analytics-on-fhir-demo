{
  "resourceType": "ViewDefinition",
  "id": "research_lab_results",
  "url": "https://example.org/aof/ViewDefinition/research_lab_results",
  "name": "research_lab_results",
  "title": "Research extract, lab results: a pseudonym, dates as recorded",
  "status": "active",
  "resource": "Observation",
  "select": [
    {
      "column": [
        {
          "name": "pseudonym",
          "path": "subject.getReferenceKey(Patient)",
          "extension": [
            {
              "url": "http://health-samurai.io/fhir/core/StructureDefinition/de-identification",
              "extension": [
                {
                  "url": "method",
                  "valueCode": "cryptoHash"
                },
                {
                  "url": "cryptoHashKey",
                  "valueString": "demo-key-not-a-secret"
                }
              ]
            }
          ]
        },
        {
          "name": "effective",
          "path": "effective.ofType(dateTime)",
          "type": "dateTime"
        },
        {
          "name": "value",
          "path": "value.ofType(Quantity).value",
          "type": "decimal"
        },
        {
          "name": "unit",
          "path": "value.ofType(Quantity).code"
        }
      ]
    },
    {
      "forEach": "code.coding",
      "column": [
        {
          "name": "system",
          "path": "system"
        },
        {
          "name": "code",
          "path": "code"
        }
      ]
    }
  ],
  "where": [
    {
      "path": "category.coding.where(system = 'http://terminology.hl7.org/CodeSystem/observation-category' and code = 'laboratory').exists()"
    },
    {
      "path": "status = 'final' or status = 'amended' or status = 'corrected'"
    }
  ]
}
